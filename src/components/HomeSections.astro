---
const route = Astro.locals.starlightRoute;
const isZh = route.lang === 'zh-CN' || route.locale === 'zh-cn';
const prefix = isZh ? '/zh-cn' : '';

const icons = {
	layers: `<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
	terminal: `<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>`,
	server: `<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>`,
	host: `<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>`,
};

const content = isZh
	? {
			routesHeading: '文档导览',
			routes: [
				{
					code: 'CONCEPTS',
					icon: icons.layers,
					title: '组件与架构总览',
					href: `${prefix}/concepts/architecture/`,
					desc: '客户端、控制面（as-control-plane）、基础设施与被控节点（Workspace + Adapter）四层边界及纯出站 WSS 隧道机制。',
					cta: '阅读架构总览',
				},
				{
					code: 'LOCAL DEV',
					icon: icons.terminal,
					title: '本地快速开始',
					href: `${prefix}/getting-started/quickstart/`,
					desc: '在单台开发机上拉起 Docker 共享依赖与热重载开发栈，签发一次性登录链接连接 Web 或 macOS Seed.app。',
					cta: '开始本地体验',
				},
				{
					code: 'CONTROL PLANE',
					icon: icons.server,
					title: '服务端部署控制面',
					href: `${prefix}/deployment/control-plane/`,
					desc: '编译无运行时依赖的独立二进制与三平台节点包，配置公共信任 CA TLS 证书或自有反向代理及成对备份策略。',
					cta: '查看服务端部署',
				},
				{
					code: 'EXECUTION HOST',
					icon: icons.host,
					title: '跨主机接入被控机',
					href: `${prefix}/deployment/add-host/`,
					desc: '生成 1 小时单次安装令牌，在 macOS / Linux 开发机完成零 sudo 注册、--root 目录授权、后台托管与原位重装恢复。',
					cta: '查看节点接入',
				},
			],
			archHeading: '系统拓扑与核心特性',
			topoAria: '四层出站连接拓扑图',
			clientsSub: 'Connect RPC · WSS 增量流',
			cpSub: 'PostgreSQL · NATS · Redis',
			outboundLabel: '纯出站 WSS (/v1/node/*)',
			hostSub: '0600 Unix Socket · Claude / Codex',
			features: [
				{
					code: '01 / OUTBOUND WSS',
					title: '纯出站零端口暴露接入',
					body: '被控开发机无需公网 IP、无需开放任何入站 TCP 端口或配置 SSH 免密；一行 install.sh 注册为用户级守护服务并主动出站建连。',
				},
				{
					code: '02 / WORKTREE ISOLATION',
					title: '多工作树与多会话并行',
					body: '按 Project → Task → Worktree → Conversation → Session 五级结构隔离上下文，跨机器并行驱动多个 Agent CLI 互不冲突。',
				},
				{
					code: '03 / HOST-AUTHORITATIVE',
					title: '执行机权威文件与实时流',
					body: '业务代码留在被控机本地磁盘而不上传整仓镜像；目录树、Git Diff、PTY 终端与运行片段通过统一事件流实时同步。',
				},
				{
					code: '04 / CURSOR RECOVERY',
					title: '断线自愈与防串机保护',
					body: '网络闪断或控制面滚动重启不中断运行中的编码回合，重连后按游标自动续传；目标主机离线时明确报错，绝不静默改派。',
				},
			],
			faqHeading: '部署与安全边界说明',
			faqs: [
				{
					q: '被控开发机在家庭 NAT、公司内网或云安全组后，需要做端口映射或内网穿透吗？',
					aHtml:
						'不需要。<code>as-workspace-server</code> 与 <code>as-adapter-host</code> 仅在本机 <code>~/.agent-system/node/state/</code> 下监听 <code>0600</code> 私有 Unix Socket，对外零 TCP 端口监听；只要能出站访问控制面 HTTPS 端口即可注册保持在线。',
				},
				{
					q: '一行安装默认会把整个用户主目录（Home）授权给 Agent 读写吗？',
					aHtml:
						'不会。默认采用<strong>零预授权策略</strong>：Home 仅作为 Web 目录选择器的只读浏览起点，拒绝直接绑定整个 Home；仅您显式确认的项目子目录或通过 <code>--root /srv/code</code> 指定的目录才会被持久授权。',
				},
				{
					q: '为什么公网控制面必须使用公共信任 CA 证书，且不能置于解密流量的第三方 CDN 后？',
					aHtml:
						'外层 WSS/HTTPS 是保护路由凭据（Route Credential）与代码字节流的唯一加密层，节点仅使用系统根证书库校验证书。必须在 <code>as-control-plane</code> 或自有 Nginx/Caddy 上终止 TLS，避免中间代理接触凭据。',
				},
				{
					q: '升级版本或误删主机后重新执行 install.sh，已绑定的项目和任务会失效吗？',
					aHtml:
						'不会。只要 <code>~/.agent-system/node/state/</code> 仍在，重新执行新安装命令会自动出示旧凭据核验身份、轮换新凭据并<strong>原位复用原 <code>host_id</code></strong>，名下项目与工作树自动恢复在线。',
				},
			],
		}
	: {
			routesHeading: 'Documentation',
			routes: [
				{
					code: 'CONCEPTS',
					icon: icons.layers,
					title: 'Architecture Overview',
					href: `${prefix}/concepts/architecture/`,
					desc: 'Four-layer runtime boundary across Clients, Control Plane (as-control-plane), Infrastructure, and Execution Hosts, plus outbound WSS multiplexing.',
					cta: 'Read architecture guide',
				},
				{
					code: 'LOCAL DEV',
					icon: icons.terminal,
					title: 'Local Quickstart',
					href: `${prefix}/getting-started/quickstart/`,
					desc: 'Boot shared Docker infrastructure and the live-reload stack on a single laptop, mint a single-use login URL, and connect Web or macOS Seed.app.',
					cta: 'Start local stack',
				},
				{
					code: 'CONTROL PLANE',
					icon: icons.server,
					title: 'Deploy Control Plane',
					href: `${prefix}/deployment/control-plane/`,
					desc: 'Build static binaries and multi-platform node bundles, configure publicly trusted CA TLS or your own reverse proxy, and pair PostgreSQL backups.',
					cta: 'Deploy server',
				},
				{
					code: 'EXECUTION HOST',
					icon: icons.host,
					title: 'Add Execution Hosts',
					href: `${prefix}/deployment/add-host/`,
					desc: 'Mint 1-hour single-use install tokens via Web or CLI for sudo-free macOS/Linux enrollment, --root scoping, service supervision, and in-place recovery.',
					cta: 'Enroll hosts',
				},
			],
			archHeading: 'System Topology & Guarantees',
			topoAria: 'Four-layer outbound connection schematic',
			clientsSub: 'Connect RPC · WSS live stream',
			cpSub: 'PostgreSQL · NATS · Redis',
			outboundLabel: 'Outbound WSS (/v1/node/*)',
			hostSub: '0600 Unix Sockets · Claude / Codex',
			features: [
				{
					code: '01 / OUTBOUND WSS',
					title: 'Zero-Inbound-Port Enrollment',
					body: 'Execution hosts require no public IP, inbound firewall rules, or SSH keys. A single install.sh command registers a user-level daemon that dials outbound.',
				},
				{
					code: '02 / WORKTREE ISOLATION',
					title: 'Parallel Worktrees & Sessions',
					body: 'Isolate concurrent work across Project → Task → Worktree → Conversation → Session, driving Claude Code and Codex across machines without branch collisions.',
				},
				{
					code: '03 / HOST-AUTHORITATIVE',
					title: 'Host-Local Code & Live Streams',
					body: 'Source trees stay on the execution host disk rather than mirroring full repos to the server; file diffs, PTY terminals, and turn deltas stream live.',
				},
				{
					code: '04 / CURSOR RECOVERY',
					title: 'Self-Healing & Strict Host Pinning',
					body: 'Brief disconnects or Control Plane restarts never terminate active turns — streams resume from cursors, and offline hosts fail explicitly without silent rerouting.',
				},
			],
			faqHeading: 'Operational & Security Notes',
			faqs: [
				{
					q: 'Do execution hosts behind home NAT, corporate firewalls, or cloud security groups need port forwarding?',
					aHtml:
						'No. Both <code>as-workspace-server</code> and <code>as-adapter-host</code> listen exclusively on <code>0600</code> private Unix sockets under <code>~/.agent-system/node/state/</code> with zero TCP ports open. Outbound HTTPS access to your Control Plane is all that is needed.',
				},
				{
					q: 'Does the one-line installer grant agents read/write access to my entire Home directory by default?',
					aHtml:
						'No. Default enrollment enforces a <strong>zero pre-authorization policy</strong>: your OS Home directory serves only as a read-only picker root and cannot itself be bound as a workspace. Only subdirectories you explicitly confirm (or paths passed via <code>--root /srv/code</code>) are persisted.',
				},
				{
					q: 'Why must a public Control Plane use a publicly trusted CA certificate without TLS-decrypting third-party CDNs?',
					aHtml:
						'Outer WSS/HTTPS is the sole transport encryption layer protecting Route Credentials and workspace streams, and nodes verify certificates strictly against the OS root store. Terminate TLS on <code>as-control-plane</code> or your own Nginx/Caddy proxy.',
				},
				{
					q: 'If I upgrade Seedrail or remove a host and re-run install.sh, will existing projects break?',
					aHtml:
						'No. As long as <code>~/.agent-system/node/state/</code> remains on disk, running a fresh install command proves identity with the prior credential, rotates secrets, and <strong>reuses the original <code>host_id</code> in place</strong>.',
				},
			],
		};
---

<div class="sr-landing not-content">
	<section class="sr-section" aria-labelledby="sr-routes-heading">
		<h2 id="sr-routes-heading" class="sr-section-title">{content.routesHeading}</h2>

		<div class="sr-grid-frame">
			<svg class="sr-corner sr-corner-tl" width="7" height="7" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true">
				<line x1="0" y1="3.5" x2="7" y2="3.5" stroke="currentColor" stroke-width="1" />
				<line x1="3.5" y1="0" x2="3.5" y2="7" stroke="currentColor" stroke-width="1" />
			</svg>
			<svg class="sr-corner sr-corner-tr" width="7" height="7" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true">
				<line x1="0" y1="3.5" x2="7" y2="3.5" stroke="currentColor" stroke-width="1" />
				<line x1="3.5" y1="0" x2="3.5" y2="7" stroke="currentColor" stroke-width="1" />
			</svg>
			<svg class="sr-corner sr-corner-bl" width="7" height="7" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true">
				<line x1="0" y1="3.5" x2="7" y2="3.5" stroke="currentColor" stroke-width="1" />
				<line x1="3.5" y1="0" x2="3.5" y2="7" stroke="currentColor" stroke-width="1" />
			</svg>
			<svg class="sr-corner sr-corner-br" width="7" height="7" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true">
				<line x1="0" y1="3.5" x2="7" y2="3.5" stroke="currentColor" stroke-width="1" />
				<line x1="3.5" y1="0" x2="3.5" y2="7" stroke="currentColor" stroke-width="1" />
			</svg>

			<div class="sr-route-grid">
				{
					content.routes.map((routeItem) => (
						<article class="sr-route-card">
							<header class="sr-route-head">
								<span class="sr-icon-box" set:html={routeItem.icon} />
								<span class="sr-mono-tag">{routeItem.code}</span>
							</header>
							<h3 class="sr-route-title">
								<a class="card-link" href={routeItem.href}>
									{routeItem.title}
								</a>
							</h3>
							<p class="sr-route-desc">{routeItem.desc}</p>
							<footer class="sr-route-cta" aria-hidden="true">
								<span>{routeItem.cta}</span>
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M5 12h14" />
									<path d="m12 5 7 7-7 7" />
								</svg>
							</footer>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="sr-section" aria-labelledby="sr-arch-heading">
		<h2 id="sr-arch-heading" class="sr-section-title">{content.archHeading}</h2>

		<div class="sr-arch-panel">
			<div class="sr-topology-strip" aria-label={content.topoAria}>
				<div class="sr-topo-box">
					<span class="sr-topo-role">CLIENTS</span>
					<strong>Web · Seed.app</strong>
					<small>{content.clientsSub}</small>
				</div>
				<div class="sr-topo-connector" aria-hidden="true">
					<span>HTTPS / WSS</span>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
						<path d="M5 12h14m-5-5 5 5-5 5" />
					</svg>
				</div>
				<div class="sr-topo-box sr-topo-box-cp">
					<span class="sr-topo-role">CONTROL PLANE</span>
					<strong>as-control-plane</strong>
					<small>{content.cpSub}</small>
				</div>
				<div class="sr-topo-connector" aria-hidden="true">
					<span>{content.outboundLabel}</span>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
						<path d="M19 12H5m5 5-5-5 5-5" />
					</svg>
				</div>
				<div class="sr-topo-box">
					<span class="sr-topo-role">EXECUTION HOST</span>
					<strong>Workspace + Adapter</strong>
					<small>{content.hostSub}</small>
				</div>
			</div>

			<div class="sr-spec-grid">
				{
					content.features.map((item) => (
						<article class="sr-spec-cell">
							<p class="sr-spec-code">{item.code}</p>
							<h3>{item.title}</h3>
							<p class="sr-spec-body">{item.body}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="sr-section" aria-labelledby="sr-faq-heading">
		<h2 id="sr-faq-heading" class="sr-section-title">{content.faqHeading}</h2>

		<div class="sr-accordion">
			{
				content.faqs.map((faq) => (
					<details>
						<summary>{faq.q}</summary>
						<div class="sr-details-body">
							<p set:html={faq.aHtml} />
						</div>
					</details>
				))
			}
		</div>
	</section>
</div>
