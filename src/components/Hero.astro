---
const route = Astro.locals.starlightRoute;
const isZh = route.lang === 'zh-CN' || route.locale === 'zh-cn';
const { data } = route.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const primaryAction = actions[0];
const secondaryAction = actions[1];

const t = isZh
	? {
			githubText: 'GitHub',
			tablistAria: '快速启动命令',
			tabEnroll: '跨主机接入被控机',
			tabLocal: '本地一键开发栈',
			cmdHint: '0 入站端口 · 用户级守护服务',
			copyAria: '复制命令到剪贴板',
			copied: '已复制',
			copyFailed: '失败',
			snippets: {
				enroll: {
					cmd: 'curl -fsSL https://cp.example.com/install.sh | AS_INSTALL_TOKEN=ast_xxxxxxxx sh',
					hint: '0 入站端口 · 用户级守护服务',
				},
				local: {
					cmd: 'pnpm install && make deps-up && make dev-detached && make dev-login',
					hint: 'Docker 共享依赖 · Worktree 独立隔离',
				},
			},
		}
	: {
			githubText: 'GitHub',
			tablistAria: 'Quickstart commands',
			tabEnroll: 'Enroll remote host',
			tabLocal: 'Local dev stack',
			cmdHint: '0 inbound ports · user-level daemon',
			copyAria: 'Copy command to clipboard',
			copied: 'Copied',
			copyFailed: 'Failed',
			snippets: {
				enroll: {
					cmd: 'curl -fsSL https://cp.example.com/install.sh | AS_INSTALL_TOKEN=ast_xxxxxxxx sh',
					hint: '0 inbound ports · user-level daemon',
				},
				local: {
					cmd: 'pnpm install && make deps-up && make dev-detached && make dev-login',
					hint: 'Shared Docker infra · isolated worktrees',
				},
			},
		};
---

<section class="sr-hero not-content" aria-labelledby="_top">
	<div class="sr-hero-header">
		<h1 id="_top" data-page-title class="sr-hero-title">
			{title}
		</h1>

		{tagline && <p class="sr-hero-tagline">{tagline}</p>}

		<div class="sr-hero-actions">
			{
				primaryAction && (
					<a class="sr-btn sr-btn-primary" href={primaryAction.link}>
						<span>{primaryAction.text}</span>
						<svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M5 12h14" />
							<path d="m12 5 7 7-7 7" />
						</svg>
					</a>
				)
			}
			{
				secondaryAction && (
					<a class="sr-btn sr-btn-secondary" href={secondaryAction.link}>
						<span>{secondaryAction.text}</span>
					</a>
				)
			}
			<a class="sr-btn sr-btn-ghost" href="https://github.com/seedrail/docs" target="_blank" rel="noreferrer">
				<svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2.02c-3.2.7-3.87-1.38-3.87-1.38-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.26 5.68.42.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
				</svg>
				<span>{t.githubText}</span>
			</a>
		</div>
	</div>

	<div class="sr-command-frame">
		<svg class="sr-corner sr-corner-tl" width="7" height="7" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true">
			<line x1="0" y1="3.5" x2="7" y2="3.5" stroke="currentColor" stroke-width="1" />
			<line x1="3.5" y1="0" x2="3.5" y2="7" stroke="currentColor" stroke-width="1" />
		</svg>
		<svg class="sr-corner sr-corner-tr" width="7" height="7" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true">
			<line x1="0" y1="3.5" x2="7" y2="3.5" stroke="currentColor" stroke-width="1" />
			<line x1="3.5" y1="0" x2="3.5" y2="7" stroke="currentColor" stroke-width="1" />
		</svg>
		<svg class="sr-corner sr-corner-bl" width="7" height="7" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true">
			<line x1="0" y1="3.5" x2="7" y2="3.5" stroke="currentColor" stroke-width="1" />
			<line x1="3.5" y1="0" x2="3.5" y2="7" stroke="currentColor" stroke-width="1" />
		</svg>
		<svg class="sr-corner sr-corner-br" width="7" height="7" viewBox="0 0 7 7" shape-rendering="crispEdges" aria-hidden="true">
			<line x1="0" y1="3.5" x2="7" y2="3.5" stroke="currentColor" stroke-width="1" />
			<line x1="3.5" y1="0" x2="3.5" y2="7" stroke="currentColor" stroke-width="1" />
		</svg>

		<div class="sr-cmd-header">
			<div class="sr-cmd-tabs" role="tablist" aria-label={t.tablistAria}>
				<button
					type="button"
					role="tab"
					id="sr-tab-enroll"
					aria-selected="true"
					aria-controls="sr-panel-cmd"
					data-cmd-mode="enroll"
					class="sr-cmd-tab"
				>
					{t.tabEnroll}
				</button>
				<button
					type="button"
					role="tab"
					id="sr-tab-local"
					aria-selected="false"
					aria-controls="sr-panel-cmd"
					data-cmd-mode="local"
					class="sr-cmd-tab"
				>
					{t.tabLocal}
				</button>
			</div>
			<span class="sr-cmd-meta" id="sr-hero-hint">{t.cmdHint}</span>
		</div>

		<div id="sr-panel-cmd" role="tabpanel" aria-labelledby="sr-tab-enroll" class="sr-cmd-row">
			<span class="sr-cmd-prompt" aria-hidden="true">$</span>
			<code id="sr-hero-code" class="sr-cmd-code">{t.snippets.enroll.cmd}</code>
			<span class="sr-copy-cell">
				<button
					type="button"
					class="sr-copy-btn"
					command="--copy"
					commandfor="sr-hero-code"
					data-copy-ok={t.copied}
					data-copy-fail={t.copyFailed}
					aria-label={t.copyAria}
				>
					<svg class="sr-icon-copy" aria-hidden="true" width="16" height="16" viewBox="0 0 256 256" fill="currentColor">
						<path d="M216,32H88a8,8,0,0,0-8,8V80H40a8,8,0,0,0-8,8V216a8,8,0,0,0,8,8H168a8,8,0,0,0,8-8V176h40a8,8,0,0,0,8-8V40A8,8,0,0,0,216,32ZM160,208H48V96H160Zm48-48H176V88a8,8,0,0,0-8-8H96V48H208Z" />
					</svg>
					<svg class="sr-icon-check" aria-hidden="true" width="16" height="16" viewBox="0 0 256 256" fill="currentColor">
						<path d="M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34Z" />
					</svg>
				</button>
				<span class="sr-copy-tip" role="status"></span>
			</span>
		</div>

		<script is:inline type="application/json" id="sr-hero-snippets" set:html={JSON.stringify(t.snippets)} />
	</div>
</section>

<script>
	const rawSnippets = document.getElementById('sr-hero-snippets')?.textContent;
	const SNIPPETS: Record<string, { cmd: string; hint: string }> = rawSnippets
		? JSON.parse(rawSnippets)
		: {};

	const tabs = document.querySelectorAll<HTMLButtonElement>('.sr-cmd-tab');
	const panel = document.getElementById('sr-panel-cmd');
	const codeEl = document.getElementById('sr-hero-code');
	const hintEl = document.getElementById('sr-hero-hint');

	for (const tab of tabs) {
		tab.addEventListener('click', () => {
			const mode = tab.dataset.cmdMode ?? 'enroll';
			const item = SNIPPETS[mode];
			if (!item || !codeEl || !panel) return;
			for (const t of tabs) {
				t.setAttribute('aria-selected', String(t === tab));
			}
			panel.setAttribute('aria-labelledby', tab.id);
			codeEl.textContent = item.cmd;
			if (hintEl) hintEl.textContent = item.hint;
		});
	}

	const timers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();
	let lastAnnounced = '';

	function legacyCopy(text: string): boolean {
		const field = Object.assign(document.createElement('textarea'), { value: text });
		field.setAttribute('readonly', '');
		field.style.cssText = 'position:fixed;inset-block-start:0;opacity:0';
		document.body.append(field);
		field.select();
		try {
			return document.execCommand('copy');
		} finally {
			field.remove();
		}
	}

	function reportCopy(button: HTMLElement, ok: boolean): void {
		const tip = button.nextElementSibling as HTMLElement | null;
		const prev = timers.get(button);
		if (prev) clearTimeout(prev);
		button.removeAttribute('data-copied');
		button.removeAttribute('data-failed');
		const okText = button.dataset.copyOk ?? 'Copied';
		const failText = button.dataset.copyFail ?? 'Failed';
		let message = ok ? okText : failText;
		if (message === lastAnnounced) message += '\u00A0';
		lastAnnounced = message;
		if (tip) tip.textContent = '';
		void button.offsetWidth;
		button.setAttribute(ok ? 'data-copied' : 'data-failed', '');
		if (tip) {
			requestAnimationFrame(() => {
				tip.textContent = message;
			});
		}
		timers.set(
			button,
			setTimeout(() => {
				button.removeAttribute('data-copied');
				button.removeAttribute('data-failed');
				if (tip) tip.textContent = '';
			}, 2000)
		);
	}

	async function runCopy(button: HTMLElement, target: HTMLElement): Promise<void> {
		const text = target.innerText.trim();
		if (!text) return;
		try {
			await navigator.clipboard.writeText(text);
			reportCopy(button, true);
		} catch {
			if (legacyCopy(text)) {
				reportCopy(button, true);
			} else {
				reportCopy(button, false);
			}
		}
	}

	if ('CommandEvent' in window) {
		document.addEventListener(
			'command',
			(event: Event) => {
				const cmdEvent = event as Event & { command?: string; source?: HTMLElement };
				if (cmdEvent.command === '--copy' && cmdEvent.source && cmdEvent.target instanceof HTMLElement) {
					void runCopy(cmdEvent.source, cmdEvent.target);
				}
			},
			true
		);
	} else {
		document.addEventListener('click', (event: MouseEvent) => {
			const targetNode = event.target instanceof Element ? event.target : null;
			const button = targetNode?.closest<HTMLElement>('button[command="--copy"]');
			if (!button) return;
			const forId = button.getAttribute('commandfor');
			const target = forId ? document.getElementById(forId) : null;
			if (target) void runCopy(button, target);
		});
	}
</script>
